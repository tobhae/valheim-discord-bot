# Copy to .env and fill in. Never commit .env: it holds your bot token and passwords.

# --- Discord ---
# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click your server icon -> Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=
# Text channel for deaths / joins / raids / server up-down (right-click it ->
# Copy Channel ID). Leave empty to disable event posts.
EVENTS_CHANNEL_ID=

# --- Sidebar rows ---
# Server name, player limit, category name, texts and switches are in config.toml.
# Leave empty and the bot creates the status rows itself (IDs saved in STATE_FILE).
# Or put the ID of a voice channel of your own here; the bot only renames it.
STATUS_CHANNEL_ID=
PLAYERS_CHANNEL_ID=

# --- Data sources ---
# STATUS_SOURCE: dathost | a2s            
# EVENT_SOURCE: dathost | docker | file | none
# For the Valheim server in dev/compose.valheim.yml, use:
# STATUS_SOURCE=a2s
# EVENT_SOURCE=docker
STATUS_SOURCE=dathost
EVENT_SOURCE=dathost

# --- DatHost ---
# Required when STATUS_SOURCE=dathost or EVENT_SOURCE=dathost.
# Your DatHost login (the API uses email + password). The server ID is the last
# part of the URL in the DatHost control panel.
DATHOST_EMAIL=
DATHOST_PASSWORD=
DATHOST_SERVER_ID=

# --- Local testing (see dev/README.md) ---
# Steam query (STATUS_SOURCE=a2s). Port is the game port + 1.
A2S_HOST=127.0.0.1
A2S_PORT=2457
# EVENT_SOURCE=docker: the container's name (docker ps) and Docker's socket.
DOCKER_CONTAINER=
# Standard Linux Docker Engine socket path; may vary by installation.
DOCKER_SOCKET=/var/run/docker.sock
# Optional: host Docker group ID, if required by your Compose setup.
# Find it with `getent group docker`.
# DOCKER_GID=

# EVENT_SOURCE=file: a log file to tail, e.g. to fake events with echo.
EVENT_LOG_FILE=dev/devlogs/valheim.log

# --- Files and logging ---
# Poll intervals and the rename interval are under [timing] in config.toml.
# The bot's memory (channel IDs, uptime, rename timers).
STATE_FILE=data/state.json
# Display settings, timing, switches and texts.
CONFIG_FILE=config.toml
LOG_LEVEL=INFO
